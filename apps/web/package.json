{
  "name": "@danarapi/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "scan:ios": "node --experimental-strip-types server/native-receipt-scan.ts",
