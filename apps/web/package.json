  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.0",
    "eslint": "^9.35.0",
    "eslint-plugin-vue": "^10.4.0",
    "qrcode": "^1.5.4",
    "typescript": "^5.9.0",
