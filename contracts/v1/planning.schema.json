{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Danarapi goals and item split additive contract v1",
  "$defs": {
    "money": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,11})$"},
    "positiveMoney": {"type": "string", "pattern": "^[1-9][0-9]{0,11}$"},
    "goal": {
      "type": "object", "required": ["id", "name", "targetAmount", "savedAmount", "version"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "name": {"type": "string", "minLength": 1, "maxLength": 100},
        "targetAmount": {"$ref": "#/$defs/positiveMoney"},
        "savedAmount": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$", "description": "Historical opening amount plus active linked expenses; read-only progress."},
        "openingAmount": {"$ref": "#/$defs/money"},
        "targetDate": {"type": ["string", "null"], "format": "date-time"},
        "version": {"type": "integer", "minimum": 0}
      }
    },
    "reportAllocation": {
      "type": "object", "required": ["id", "name", "amount"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "amount": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"}
      },
      "description": "Disjoint actual expense segment. Target contributions precede category/budget segments; segments sum to personalExpense."
    },
    "allocation": {
      "type": "object", "required": ["memberID", "quantity"],
      "properties": {"memberID": {"type": "string", "minLength": 1}, "quantity": {"type": "integer", "minimum": 0, "maximum": 999}}
    },
    "item": {
      "type": "object", "required": ["id", "name", "quantity", "unitPrice", "allocations"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1, "maxLength": 160},
        "quantity": {"type": "integer", "minimum": 0, "maximum": 999}, "unitPrice": {"$ref": "#/$defs/money"},
        "allocations": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/allocation"}}
      }
    },
    "itemSplit": {
      "type": "object", "required": ["items", "tax", "service", "discount"],
      "properties": {
        "items": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/item"}},
        "tax": {"$ref": "#/$defs/money"}, "service": {"$ref": "#/$defs/money"}, "discount": {"$ref": "#/$defs/money"},
        "rounding": {"type": "string", "pattern": "^-?(0|[1-9][0-9]{0,11})$"},
        "settings": {"type": ["object", "null"], "required": ["serviceRate", "taxRate", "taxOnService"], "properties": {
          "serviceRate": {"type": "number", "minimum": 0, "maximum": 100, "multipleOf": 0.01},
          "taxRate": {"type": "number", "minimum": 0, "maximum": 100, "multipleOf": 0.01},
          "taxOnService": {"type": "boolean"}, "taxIncluded": {"type": "boolean"}
        }}
      },
      "if": {"required": ["settings"], "properties": {"settings": {"type": "object"}}},
      "then": {"properties": {"items": {"items": {"properties": {"allocations": {"items": {"properties": {"quantity": {"const": 1}}}}}}}}},
      "else": {"properties": {"items": {"items": {"properties": {"quantity": {"minimum": 1}, "unitPrice": {"$ref": "#/$defs/positiveMoney"}}}}}},
      "description": "Without settings: legacy quantity allocations and nominal adjustments. With settings: allocations select shared owners; discount and signed rounding proportional to subtotal, service/tax on discounted subtotal, inclusive tax adds no charges. Each column uses largest remainder with participant-order ties. Server validates final shares."
    }
  }
}
